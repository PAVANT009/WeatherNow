# WeatherNow – local development environment variables
# Copy this file to .env and adjust values as needed:
#   copy .env.example .env   (PowerShell / cmd)

# PostgreSQL (must match docker-compose.yml)
POSTGRES_USER=weathernow
POSTGRES_PASSWORD=weathernow
POSTGRES_DB=weathernow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy connection string
DATABASE_URL=postgresql+psycopg://weathernow:weathernow@localhost:5432/weathernow

# FastAPI
APP_NAME=WeatherNow
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# External weather provider (Open-Meteo – no API key required for basic usage)
WEATHER_PROVIDER=open_meteo
WEATHER_PROVIDER_BASE_URL=https://api.open-meteo.com
WEATHER_PROVIDER_TIMEOUT_SECONDS=10
