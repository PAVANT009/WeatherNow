# WeatherNow backend – copy to .env in this folder or use the repo root .env
# Recommended: keep a single root .env and point DATABASE_URL here if needed.

DATABASE_URL=postgresql+psycopg://weathernow:weathernow@localhost:5432/weathernow
APP_NAME=WeatherNow
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
WEATHER_PROVIDER=open_meteo
WEATHER_PROVIDER_BASE_URL=https://api.open-meteo.com
WEATHER_PROVIDER_TIMEOUT_SECONDS=10
